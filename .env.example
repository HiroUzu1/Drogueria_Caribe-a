# =============================================================================
# Drogueria Caribe - POS - Variables de entorno (SANDBOX)
# Copiar este archivo a .env y rellenar. NUNCA commitear credenciales reales.
# =============================================================================

# --- App ---
APP_ENV=development
APP_DEBUG=true

# --- Base de datos (PostgreSQL en Docker) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=farmacia_pos
# docker compose arma DATABASE_URL para el contenedor; esta es para correr fuera de Docker
DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5432/farmacia_pos

# --- Administración (inventario y registro de ventas, header X-Admin-Key) ---
ADMIN_API_KEY=replace-with-a-long-random-key

# --- Factus Pay (Sandbox) ---
FACTUS_PAY_BASE_URL=https://pay-api-sandbox.factus.com.co
FACTUS_PAY_EMAIL=
FACTUS_PAY_PASSWORD=
# Llave configurada en el panel de Factus Pay; llega como ?key=... en el webhook
FACTUS_PAY_WEBHOOK_KEY=replace-with-the-key-set-in-factus
FACTUS_PAY_QR_EXPIRATION_SECONDS=1800

# --- Factus Facturación (Sandbox) - API oficial v2 ---
FACTUS_BILL_BASE_URL=https://api-sandbox.factus.com.co
FACTUS_BILL_CLIENT_ID=
FACTUS_BILL_CLIENT_SECRET=
FACTUS_BILL_USERNAME=
FACTUS_BILL_PASSWORD=
FACTUS_NUMBERING_RANGE_ID=123

# --- Frontend ---
VITE_API_URL=http://localhost:8000
