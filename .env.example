# =============================================================================
# Drogueria Caribe - POS - Variables de entorno (SANDBOX)
# Copiar este archivo a .env y rellenar con credenciales reales de pruebas.
# NUNCA commitear credenciales reales.
# =============================================================================

# --- App ---
APP_ENV=development
APP_DEBUG=true

# --- Base de datos (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=farmacia_pos
# URL asíncrona (app FastAPI / asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/farmacia_pos
# URL síncrona (alembic / scripts seed)
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/farmacia_pos

# --- Factus Facturación (Sandbox) - API oficial v2 ---
FACTUS_BILL_BASE_URL=https://api-sandbox.factus.com.co
FACTUS_BILL_CLIENT_ID=your_client_id_sandbox
FACTUS_BILL_CLIENT_SECRET=your_client_secret_sandbox
FACTUS_BILL_USERNAME=your_username_sandbox
FACTUS_BILL_PASSWORD=your_password_sandbox
FACTUS_NUMBERING_RANGE_ID=123

# --- Factus Pay (Sandbox) - POR CONFIRMAR (documentación pendiente) ---
FACTUS_PAY_BASE_URL=https://api-sandbox.factus.com.co
FACTUS_PAY_CLIENT_ID=your_pay_client_id_sandbox
FACTUS_PAY_CLIENT_SECRET=your_pay_client_secret_sandbox
FACTUS_PAY_WEBHOOK_SECRET=webhook_signing_secret_sandbox

# --- Frontend ---
VITE_API_URL=http://localhost:8000
